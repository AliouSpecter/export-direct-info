    {
      "parameters": { "jsCode": "const p = $json.properties || {};\nconst resumeProp = p['Résumé'] || {};\nconst resumeText = (resumeProp.rich_text && resumeProp.rich_text[0] && resumeProp.rich_text[0].plain_text) || '';\nif (resumeText.trim()) {\n  return [];\n}\nconst titleProp = p['Nom de la tâche'] || {};\nconst title = (titleProp.title && titleProp.title[0] && titleProp.title[0].plain_text) || '';\nreturn [{ json: { message: { text: title.trim() }, notion_page_id: $json.id } }];" },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-64, 0],
      "id": "0ae856c5-c0bf-4434-93e1-89700bfaa0ca",
      "name": "Contexte Notion (sujet)"
    },
    {
      "parameters": { "jsCode": "const raw = ($json.choices && $json.choices[0] && $json.choices[0].message)\n  ? $json.choices[0].message.content : ($json.content || '');\nlet text = String(raw || '');\ntext = text.replace(/\\[\\d+(?:\\]\\[\\d+)*\\]/g, '');\nconst pageId = $('Contexte Notion (sujet)').first().json.notion_page_id;\n\nfunction toBlocks(t) {\n  const blocks = [];\n  const paras = t.split(/\\n{2,}/).filter(p => p.trim());\n  for (const para of paras) {\n    const line = para.trim();\n    if (line.startsWith('## ')) {\n      blocks.push({ type: 'heading_2', heading_2: { rich_text: [{ type: 'text', text: { content: line.replace(/^## /, '').slice(0, 1990) } }] } });\n    } else if (line.startsWith('# ')) {\n      blocks.push({ type: 'heading_1', heading_1: { rich_text: [{ type: 'text', text: { content: line.replace(/^# /, '').slice(0, 1990) } }] } });\n    } else {\n      let rem = line;\n      while (rem.length > 0) {\n        blocks.push({ type: 'paragraph', paragraph: { rich_text: [{ type: 'text', text: { content: rem.slice(0, 1900) } }] } });\n        rem = rem.slice(1900);\n      }\n    }\n  }\n  return blocks;\n}\n\nconst contentBlocks = toBlocks(text);\nconst notion_blocks = { children: [\n  { type: 'heading_2', heading_2: { rich_text: [{ type: 'text', text: { content: 'Brief généré' } }] } },\n  ...contentBlocks\n] };\nconst brief_text = text.slice(0, 1500);\nreturn [{ json: { notion_page_id: pageId, notion_blocks, brief_text } }];" },
