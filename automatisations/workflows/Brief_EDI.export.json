    {
      "parameters": { "jsCode": "const parts = $json.candidates?.[0]?.content?.parts ?? [];\nconst text = parts.map(p => p.text).filter(Boolean).join('\\n').trim();\nconst match = text.match(/\\{[\\s\\S]*\\}/);\nif (!match) throw new Error('Aucun JSON trouvé dans la réponse du modèle.');\nlet data;\ntry { data = JSON.parse(match[0]); } catch(e) { throw new Error('JSON invalide: ' + e.message); }\nconst prompts = data.image_prompts || data.prompts;\nif (!Array.isArray(prompts) || prompts.length === 0) throw new Error('image_prompts manquant ou vide.');\nreturn [{ json: { image_prompts: prompts } }];" },
